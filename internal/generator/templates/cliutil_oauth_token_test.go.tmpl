func TestOAuthTokenHTTPClientCheckRedirectIsNeverNil(t *testing.T) {
	t.Parallel()

	c := OAuthTokenHTTPClient(nil)
	if c.CheckRedirect == nil {
		t.Fatal("OAuthTokenHTTPClient must set CheckRedirect; nil restores Go's default 10-hop cross-host policy")
	}
	leaky := &http.Client{
		CheckRedirect: func(*http.Request, []*http.Request) error { return nil },
	}
	wrapped := OAuthTokenHTTPClient(leaky)
	if wrapped.CheckRedirect == nil {
		t.Fatal("wrapping a client whose CheckRedirect allows every hop must still install the same-origin callback")
	}
}

func TestOAuthTokenHTTPClientRefusesCrossOriginRedirect(t *testing.T) {
	t.Parallel()

	for _, status := range []int{http.StatusTemporaryRedirect, http.StatusPermanentRedirect, http.StatusFound, http.StatusSeeOther} {
		t.Run(http.StatusText(status), func(t *testing.T) {
			t.Parallel()

			const secret = "client-secret-must-not-leave-origin"
			var hits atomic.Int64
			var leaked atomic.Bool
			evil := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				hits.Add(1)
				body, _ := io.ReadAll(r.Body)
				if strings.Contains(string(body), secret) {
					leaked.Store(true)
				}
				if _, pass, ok := r.BasicAuth(); ok && pass == secret {
					leaked.Store(true)
				}
				w.WriteHeader(http.StatusOK)
			}))
			defer evil.Close()

			origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.Header().Set("Location", evil.URL+"/stolen")
				w.WriteHeader(status)
			}))
			defer origin.Close()

			req, err := http.NewRequest(http.MethodPost, origin.URL+"/token", strings.NewReader("grant_type=refresh_token&client_secret="+secret))
			if err != nil {
				t.Fatalf("NewRequest: %v", err)
			}
			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
			req.SetBasicAuth("client-id", secret)

			resp, err := OAuthTokenHTTPClient(origin.Client()).Do(req)
			if err == nil {
				if resp != nil {
					resp.Body.Close()
				}
				t.Fatal("expected cross-origin redirect to fail")
			}
			if !strings.Contains(err.Error(), "oauth token exchange refused cross-origin redirect") {
				t.Fatalf("error = %v, want cross-origin refusal", err)
			}
			if hits.Load() != 0 {
				t.Fatalf("cross-origin hop was followed: hits=%d leaked=%v", hits.Load(), leaked.Load())
			}
			if leaked.Load() {
				t.Fatal("client_secret reached the redirect target")
			}
		})
	}
}

func TestOAuthTokenHTTPClientAllowsSameOriginRedirect(t *testing.T) {
	t.Parallel()

	var sawSecret atomic.Bool
	mux := http.NewServeMux()
	mux.HandleFunc("/token", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Location", "/token-real")
		w.WriteHeader(http.StatusTemporaryRedirect)
	})
	mux.HandleFunc("/token-real", func(w http.ResponseWriter, r *http.Request) {
		if err := r.ParseForm(); err != nil {
			t.Errorf("ParseForm: %v", err)
			http.Error(w, "bad form", http.StatusBadRequest)
			return
		}
		if r.Form.Get("client_secret") == "same-origin-secret" {
			sawSecret.Store(true)
		}
		w.Header().Set("Content-Type", "application/json")
		_, _ = io.WriteString(w, `{"access_token":"ok","expires_in":3600}`)
	})
	srv := httptest.NewServer(mux)
	defer srv.Close()

	req, err := http.NewRequest(http.MethodPost, srv.URL+"/token", strings.NewReader("grant_type=refresh_token&client_secret=same-origin-secret"))
	if err != nil {
		t.Fatalf("NewRequest: %v", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")

	resp, err := OAuthTokenHTTPClient(srv.Client()).Do(req)
	if err != nil {
		t.Fatalf("same-origin 307: %v", err)
	}
	defer resp.Body.Close()
	if resp.StatusCode != http.StatusOK {
		t.Fatalf("status = %d, want 200", resp.StatusCode)
	}
	if !sawSecret.Load() {
		t.Fatal("same-origin 307 should replay the POST body to the redirected path")
	}
}

